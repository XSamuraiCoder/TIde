{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TIde",
  "version": "1.1.0",
  "identifier": "com.tide.tide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TIde",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBBNkUwRTlEMTgxQjY1N0YKUldSL1pSc1luUTV1Q2c4eEM2V0NocDNJTFJ0Z05LVHFvcEFYK2FGeGVsSHdDT09BbmJFdzQ4em4K",
      "endpoints": [
        "https://github.com/XSamuraiCoder/TIde/releases/download/latest/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
